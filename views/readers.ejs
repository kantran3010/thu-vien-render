<%- include('partials/header') %>
<h1 class="h3 mb-3">Độc giả</h1>
<div class="row g-4">
  <div class="col-lg-8">
    <div class="table-responsive card"><table class="table table-hover mb-0">
      <thead class="table-light"><tr><th>Mã thẻ</th><th>Họ tên</th><th>Liên hệ</th><th class="text-center">Đang mượn</th><th class="text-center">Quá hạn</th><th>Tài khoản</th><th></th></tr></thead>
      <tbody>
      <% readers.forEach(r => { %>
        <tr><td><%= r.card_code %></td><td><%= r.full_name %><div class="small text-muted">@<%= r.username %></div></td>
          <td class="small"><%= r.phone || '' %><br><%= r.email || '' %></td>
          <td class="text-center"><%= r.borrowing %></td>
          <td class="text-center"><% if (r.overdue) { %><span class="badge text-bg-danger"><%= r.overdue %></span><% } else { %>0<% } %></td>
          <td><% if (r.locked_at) { %><span class="badge text-bg-danger">Bị khóa</span><% } else { %><span class="badge text-bg-success">Hoạt động</span><% } %><% if (r.debt > 0) { %><div class="small text-danger">Nợ <%= money(r.debt) %></div><% } %></td>
          <td class="text-end"><% if (!r.locked_at) { %><a class="btn btn-sm btn-outline-primary" href="/loans/new?reader=<%= r.id %>">Cho mượn</a><% } %></td></tr>
      <% }) %>
      </tbody>
    </table></div>
  </div>
  <div class="col-lg-4">
    <form class="card card-body" method="post" action="/readers">
      <h2 class="h5">Cấp thẻ độc giả</h2>
      <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
      <div class="mb-2"><label class="form-label" for="full_name">Họ và tên</label><input class="form-control" id="full_name" name="full_name" value="<%= form.full_name || '' %>" required></div>
      <div class="mb-2"><label class="form-label" for="username">Tên đăng nhập</label><input class="form-control" id="username" name="username" value="<%= form.username || '' %>" required></div>
      <div class="mb-2"><label class="form-label" for="password">Mật khẩu ban đầu</label><input class="form-control" id="password" name="password" type="password" minlength="6" required></div>
      <div class="mb-2"><label class="form-label" for="phone">Điện thoại</label><input class="form-control" id="phone" name="phone" value="<%= form.phone || '' %>"></div>
      <div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" value="<%= form.email || '' %>"></div>
      <button class="btn btn-primary">Tạo thẻ</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
