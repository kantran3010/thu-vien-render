<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Kho sách <small class="text-muted fs-6">(<%= total %> kết quả)</small></h1>
  <% if (user.role === 'admin') { %><a class="btn btn-primary" href="/books/new">+ Thêm sách</a><% } %>
</div>
<form class="row g-2 mb-3" method="get" action="/books">
  <div class="col-md-6"><input class="form-control" name="q" value="<%= q %>" placeholder="Tìm theo tên sách, tác giả, ISBN" aria-label="Từ khóa"></div>
  <div class="col-md-4"><select class="form-select" name="category" aria-label="Thể loại">
    <option value="">Tất cả thể loại</option>
    <% categories.forEach(c => { %><option <%= c === category ? 'selected' : '' %>><%= c %></option><% }) %>
  </select></div>
  <div class="col-md-2"><button class="btn btn-outline-primary w-100">Tìm</button></div>
</form>
<div class="table-responsive card"><table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>Năm</th><th class="text-center">Còn / Tổng</th><% if (user.role === 'admin') { %><th></th><% } %></tr></thead>
  <tbody>
  <% books.forEach(b => { %>
    <tr>
      <td><strong><%= b.title %></strong><div class="small text-muted">ISBN: <%= b.isbn || '—' %></div></td>
      <td><%= b.author %></td><td><%= b.category %></td><td><%= b.publish_year || '' %></td>
      <td class="text-center"><span class="badge text-bg-<%= b.available_copies > 0 ? 'success' : 'secondary' %>"><%= b.available_copies %> / <%= b.total_copies %></span></td>
      <% if (user.role === 'admin') { %>
      <td class="text-end text-nowrap">
        <a class="btn btn-sm btn-outline-secondary" href="/books/<%= b.id %>/edit">Sửa</a>
        <form class="d-inline" method="post" action="/books/<%= b.id %>/delete" data-confirm="Xóa sách &quot;<%= b.title %>&quot;?"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
      </td>
      <% } %>
    </tr>
  <% }) %>
  <% if (!books.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Không tìm thấy sách phù hợp.</td></tr><% } %>
  </tbody>
</table></div>
<% if (pages > 1) { %>
<nav class="mt-3"><ul class="pagination justify-content-center">
  <% for (let p = 1; p <= pages; p++) { %>
  <li class="page-item <%= p === page ? 'active' : '' %>"><a class="page-link" href="/books?q=<%= encodeURIComponent(q) %>&category=<%= encodeURIComponent(category) %>&page=<%= p %>"><%= p %></a></li>
  <% } %>
</ul></nav>
<% } %>
<%- include('../partials/footer') %>
