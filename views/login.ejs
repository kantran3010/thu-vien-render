<%- include('partials/header') %>
<div class="auth-box card shadow-sm">
  <div class="card-body p-4">
    <h1 class="h4 mb-3">Đăng nhập</h1>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="post" action="/login">
      <div class="mb-3"><label class="form-label" for="username">Tên đăng nhập</label>
        <input class="form-control" id="username" name="username" required autofocus></div>
      <div class="mb-3"><label class="form-label" for="password">Mật khẩu</label>
        <input class="form-control" id="password" name="password" type="password" required></div>
      <button class="btn btn-primary w-100">Đăng nhập</button>
    </form>
    <p class="text-center mt-3 mb-0 small">Chưa có thẻ? <a href="/register">Đăng ký độc giả</a></p>
  </div>
</div>
<%- include('partials/footer') %>
