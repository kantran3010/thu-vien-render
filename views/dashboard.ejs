<%- include('partials/header') %>
<h1 class="h3 mb-4">Tổng quan</h1>
<% if (stats) { %>
<div class="row g-3 mb-4">
  <% [
    ['Đầu sách', stats.titles, 'primary'],
    ['Tổng số bản', stats.copies, 'secondary'],
    ['Còn trong kho', stats.available, 'success'],
    ['Độc giả', stats.readers, 'info'],
    ['Đang cho mượn', stats.borrowing, 'warning'],
    ['Quá hạn', stats.overdue, 'danger'],
  ].forEach(([label, value, color]) => { %>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card stat-card border-<%= color %> h-100"><div class="card-body text-center">
      <div class="display-6 text-<%= color %>"><%= value %></div><div class="small text-muted"><%= label %></div>
    </div></div>
  </div>
  <% }) %>
</div>
<p class="text-muted">Tiền phạt đã thu: <strong><%= money(stats.fines) %></strong></p>
<div class="d-flex gap-2 flex-wrap">
  <a class="btn btn-primary" href="/loans/new">+ Lập phiếu mượn</a>
  <a class="btn btn-outline-primary" href="/loans?status=overdue">Xem sách quá hạn</a>
  <a class="btn btn-outline-primary" href="/books/new">+ Thêm sách</a>
</div>
<% } else { %>
<div class="row g-3 mb-4">
  <div class="col-sm-6"><div class="card h-100"><div class="card-body text-center">
    <div class="display-6 text-primary"><%= mine.borrowing %></div><div class="text-muted">Cuốn đang mượn (tối đa <%= rules.maxActiveLoans %>)</div></div></div></div>
  <div class="col-sm-6"><div class="card h-100"><div class="card-body text-center">
    <div class="display-6 <%= mine.overdue ? 'text-danger' : 'text-success' %>"><%= mine.overdue %></div><div class="text-muted">Cuốn quá hạn</div></div></div></div>
</div>
<% if (mine.overdue) { %><div class="alert alert-danger">Bạn có sách quá hạn. Vui lòng trả sách; phạt <%= money(rules.finePerDay) %>/ngày và không thể mượn thêm cho đến khi trả.</div><% } %>
<div class="d-flex gap-2"><a class="btn btn-primary" href="/books">Tra cứu sách</a><a class="btn btn-outline-primary" href="/my-loans">Sách của tôi</a></div>
<% } %>
<%- include('partials/footer') %>
