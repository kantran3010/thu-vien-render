<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Thư viện</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">📚 Thư viện</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Mở menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <% if (user) { %>
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/">Tổng quan</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/books') ? 'active' : '' %>" href="/books">Kho sách</a></li>
        <% if (user.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/loans') ? 'active' : '' %>" href="/loans">Phiếu mượn</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/readers') ? 'active' : '' %>" href="/readers">Độc giả</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/reports') ? 'active' : '' %>" href="/reports">Báo cáo</a></li>
        <% } else { %>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/my-loans') ? 'active' : '' %>" href="/my-loans">Sách của tôi</a></li>
        <% } %>
      </ul>
      <form method="post" action="/logout" class="d-flex align-items-center gap-2">
        <span class="text-white-50 small"><%= user.name %> (<%= user.role === 'admin' ? 'Thủ thư' : 'Độc giả' %>)</span>
        <button class="btn btn-sm btn-outline-light">Đăng xuất</button>
      </form>
      <% } %>
    </div>
  </div>
</nav>
<main class="container py-4">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
    <%= flash.text %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
  </div>
<% } %>
